<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application -->
  <PropertyGroup>
    <AssemblyName>biocstools</AssemblyName>
    <RootNamespace>Biocs</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  
  <!-- Global Usings -->
  <ItemGroup>
    <Using Include="System.ComponentModel.DataAnnotations" />
    <Using Include="ConsoleAppFramework" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Build -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <Version>$([System.DateTime]::Now.ToString(yyyy.M.d))</Version>
    <InformationalVersion>$(Version) build at $([System.DateTime]::Now.ToString(HH:mm:ss))</InformationalVersion>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <ProjectReference Include="..\core\core.csproj" />
  </ItemGroup>

</Project>
